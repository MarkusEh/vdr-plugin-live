<%pre>
// Do not write an ecpp comment into this file. It must produce no
// HTML output not even an empty line.

#include <setup.h>
#include <recman.h>
#include <vdr/menu.h>

using namespace vdrlive;

</%pre>
<%args>
  std::string param;
</%args>
<%include>page.eh</%include>
<& login.authentication &><%cpp>
// there must be no newline after <& login.authentication &> (before <%cpp>),
// otherwise there will be a newline in the output, which will break the resulting XML file

  reply.setContentType( "application/xml" );

  const char *error_message = "";
  {
    LOCK_RECORDINGS_READ;
    const cRecording *recording = RecordingsManager::GetByHash(RecordingsManager::GetHash(param), Recordings);
    if (!recording)
      error_message = tr("Couldn't find recording or no recordings available");
  }

  if (*error_message == 0) {
    const char *current = cReplayControl::NowReplaying();
    if (!current) {
      error_message = tr("Not playing a recording");
    } else {
      cReplayControl::SetRecording(0);
      cControl::Shutdown();
    }
  }

</%cpp>
<& xmlresponse.ajax name=("stop_recording") pname=("recording") value=(param) result=(*error_message == 0) error=(error_message) &>
