<%pre>
// Do not write an ecpp comment into this file. It must produce no
// HTML output not even an empty line.

#include <setup.h>

using namespace vdrlive;

</%pre>
<%args>
int quality = 80;
int width = 640;
int height = 360;
</%args>
<%include>page.eh</%include>
<& login.authentication &><%cpp>
// there must be no newline after <& login.authentication &> (before <%cpp>),
// otherwise there will be a newline in the output, which will break the resulting binary file (image)

  reply.setContentType("image/jpg");

  cDevice* device = cDevice::PrimaryDevice();
  if (device) {
    int size = 0;
    uchar* image = device->GrabImage(size, true, quality, width, height);
    if (image) {
      reply.out().write(reinterpret_cast<const char*>(image), size);
      free(image);
    }
  }
</%cpp>
