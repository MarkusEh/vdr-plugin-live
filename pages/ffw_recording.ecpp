<%pre>
// Do not write an ecpp comment into this file. It must produce no
// HTML output not even an empty line.

#include <setup.h>
#include <recman.h>
#include <vdr/menu.h>

using namespace vdrlive;

</%pre>
<%args>
  std::string param;
</%args>
<%include>page.eh</%include>
<& login.authentication &><%cpp>
// there must be no newline after <& login.authentication &> (before <%cpp>),
// otherwise there will be a newline in the output, which will break the resulting XML file

  reply.setContentType( "application/xml" );

  const char *error_message = "";
  switch (RecordingsManager::CheckReplay(RecordingsManager::GetHash(param))) {
    case 1: error_message = tr("Couldn't find recording or no recordings available"); break;
    case 2: error_message = tr("Not playing a recording"); break;
    case 3: error_message = tr("Not playing the same recording as from request"); break;
    default: break;
  }

  if (*error_message == 0) {
#if APIVERSNUM >= 20402
    cMutexLock mutexLock;
    cReplayControl* replayControl = reinterpret_cast<cReplayControl*>(cControl::Control(mutexLock));
#else
    cReplayControl* replayControl = reinterpret_cast<cReplayControl*>(cControl::Control());
#endif
    if (replayControl)
      replayControl->Forward();
    else
      error_message = tr("Cannot control playback!");
  }

</%cpp>
<& xmlresponse.ajax name=("ffw_recording") pname=("recording") value=(param) result=(*error_message == 0) error=(error_message) &>
